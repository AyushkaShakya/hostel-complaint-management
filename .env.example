# Copy this file to .env and fill in both values to switch from demo data
# to your real Supabase backend. Leave them empty to keep using demo data.
# Find them in Supabase > Project Settings > API (Project URL + anon/publishable key).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Razorpay keys do NOT go here. They are stored as Edge Function secrets
# in Supabase (see SETUP.md), so the Key Secret never reaches the browser.
